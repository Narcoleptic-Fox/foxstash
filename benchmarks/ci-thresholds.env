# Recall/QPS gate thresholds for `.github/workflows/benchmark-gate.yml`.
#
# This file exists so that changing a gate threshold is a reviewable diff, not
# an invisible edit buried in workflow YAML. Bump SIFT10K_MIN_RECALL only with
# a real benchmark run backing the new number, and say what changed and why in
# the commit/PR — this is the checked-in record of "what recall counts as
# broken" for this dataset.
#
# Baseline: sift10k (10,000 base x 128d, 1,000 queries), ef=100, measured on
# 0617c6c (2026-07-12): recall@10 = 96.88%, QPS = 9,366 single-threaded
# (benchmarks/scoreboard-20260712-151303.txt). hnswlib and faiss score 94.28%
# and 95.87% recall at the same ef on the same run, so a healthy foxstash graph
# is expected to lead them here, not trail.
#
# HNSWConfig.seed is unset in crates/benches/examples/pareto.rs, so each CI run
# builds the graph with a different random seed (level assignment varies) —
# recall@10 at fixed ef is NOT bit-for-bit reproducible run to run. Thresholds
# below carry real margin for that, not to tolerate a genuine regression: every
# recall bug that has actually shipped here (BuildStrategy::Sequential
# panicking on all input, the 1.1%-recall RaBitQ quantizer) collapsed this
# number by tens of points, not fractions of one.

# ef_search value the gate measures at. Must be one of pareto's fixed sweep
# points: 10, 20, 50, 100, 200, 500.
SIFT10K_EF=100

# HARD GATE — build fails if recall@10 at SIFT10K_EF drops below this.
SIFT10K_MIN_RECALL=90.0

# ADVISORY ONLY — never fails the build, only annotates the job with a
# warning. See the "Evaluate gate" step in benchmark-gate.yml for why QPS on a
# shared GitHub-hosted runner is not a hard gate. Set well below the measured
# baseline (9,366) to flag only catastrophic slowdowns, not runner noise.
SIFT10K_QPS_ADVISORY_FLOOR=3000
